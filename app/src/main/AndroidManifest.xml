<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenIQ">

        <!-- Main Dashboard & Demo Hub -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScreenIQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Translucent Overlay Activity for 2-Finger Swipe Gesture & Floating Result Window -->
        <activity
            android:name=".ui.overlay.ScreenIQOverlayActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenIQ.TranslucentOverlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- ScreenIQ System Accessibility Service for Gesture Detection -->
        <service
            android:name=".service.accessibility.ScreenIQAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Development & Testing Fallback Trigger BroadcastReceiver -->
        <receiver
            android:name=".gesture.DevFallbackTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.screeniq.TRIGGER_FALLBACK" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
