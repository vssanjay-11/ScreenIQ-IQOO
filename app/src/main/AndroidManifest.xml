<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- ScreenIQ System Accessibility Service for Gesture Detection -->
        <service
            android:name=".service.accessibility.ScreenIQAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Development & Testing Fallback Trigger BroadcastReceiver -->
        <receiver
            android:name=".gesture.DevFallbackTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.screeniq.TRIGGER_FALLBACK" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
